<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="OfficialStudentReportCard" pageWidth="595" pageHeight="842" columnWidth="545"
              leftMargin="25" rightMargin="25" topMargin="20" bottomMargin="20"
              uuid="e3c79a94-b20b-4e89-a2e6-81cf432a1040">

    <!-- Injected School Parameters -->
    <parameter name="P_SCHOOL_NAME" class="java.lang.String"/>
    <parameter name="P_SCHOOL_CODE" class="java.lang.String"/>
    <parameter name="P_LOGO_PATH" class="java.lang.String"/>
    <parameter name="P_PRINCIPAL_SIGNATURE" class="java.lang.String"/>
    <parameter name="P_ACADEMIC_YEAR" class="java.lang.String"/>
    <parameter name="P_TERM_NAME" class="java.lang.String"/>
    <parameter name="P_SCALE_NAME" class="java.lang.String"/>

    <!-- Student Metadata Fields -->
    <field name="studentName" class="java.lang.String"/>
    <field name="admissionNumber" class="java.lang.String"/>
    <field name="className" class="java.lang.String"/>
    <field name="gpaOrAverage" class="java.lang.String"/>
    <field name="classRank" class="java.lang.String"/>
    <field name="honorStatus" class="java.lang.String"/>

    <!-- Attendance Fields -->
    <field name="daysEnrolled" class="java.lang.Integer"/>
    <field name="daysPresent" class="java.lang.Integer"/>
    <field name="daysAbsent" class="java.lang.Integer"/>
    <field name="attendanceRate" class="java.lang.String"/>

    <!-- Subject Detail Band Fields (Dynamic per row) -->
    <field name="subjectCode" class="java.lang.String"/>
    <field name="subjectName" class="java.lang.String"/>
    <field name="creditHours" class="java.lang.String"/>
    <field name="rawScore" class="java.lang.Double"/>
    <field name="maxScore" class="java.lang.Double"/>
    <field name="letterGrade" class="java.lang.String"/>
    <field name="teacherRemarks" class="java.lang.String"/>

    <!-- 1. TITLE BAND -->
    <title>
        <band height="75">
            <image onErrorType="Blank">
                <reportElement x="0" y="0" width="60" height="60" uuid="a1b2c3d4-1111-2222-3333-444455556666"/>
                <imageExpression><![CDATA[$P{P_LOGO_PATH}]]></imageExpression>
            </image>
            <textField>
                <reportElement x="70" y="5" width="475" height="22" uuid="a1b2c3d4-2222-3333-4444-555566667777"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{P_SCHOOL_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="70" y="28" width="475" height="14" uuid="a1b2c3d4-3333-4444-5555-666677778888"/>
                <textElement textAlignment="Center">
                    <font size="10" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["OFFICIAL ACADEMIC PROGRESS REPORT • " + $P{P_TERM_NAME} + " (" + $P{P_ACADEMIC_YEAR} + ")"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="70" width="545" height="1" forecolor="#CBD5E1" uuid="a1b2c3d4-4444-5555-6666-777788889999"/>
            </line>
        </band>
    </title>

    <!-- 2. PAGE HEADER BAND: Student Meta -->
    <pageHeader>
        <band height="45">
            <rectangle radius="4">
                <reportElement x="0" y="0" width="545" height="38" backcolor="#F8FAFC" forecolor="#E2E8F0" uuid="b1b2b3b4-1111-2222-3333-444455556666"/>
            </rectangle>
            <textField>
                <reportElement x="10" y="6" width="250" height="13" uuid="b1b2b3b4-2222-3333-4444-555566667777"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Student: " + $F{studentName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="10" y="20" width="250" height="13" uuid="b1b2b3b4-3333-4444-5555-666677778888"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Admission No: " + $F{admissionNumber}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="280" y="6" width="250" height="13" uuid="b1b2b3b4-4444-5555-6666-777788889999"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Class: " + $F{className}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="280" y="20" width="250" height="13" uuid="b1b2b3b4-5555-6666-7777-888899990000"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Scale: " + $P{P_SCALE_NAME}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <!-- 3. COLUMN HEADER BAND -->
    <columnHeader>
        <band height="22">
            <rectangle>
                <reportElement x="0" y="0" width="545" height="20" backcolor="#F1F5F9" forecolor="#CBD5E1" uuid="c1c2c3c4-1111-2222-3333-444455556666"/>
            </rectangle>
            <staticText>
                <reportElement x="5" y="3" width="40" height="14" uuid="c1c2c3c4-2222-3333-4444-555566667777"/>
                <textElement textAlignment="Center"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[CODE]]></text>
            </staticText>
            <staticText>
                <reportElement x="50" y="3" width="180" height="14" uuid="c1c2c3c4-3333-4444-5555-666677778888"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[SUBJECT NAME]]></text>
            </staticText>
            <staticText>
                <reportElement x="235" y="3" width="80" height="14" uuid="c1c2c3c4-4444-5555-6666-777788889999"/>
                <textElement textAlignment="Center"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[SCORE / MAX]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="3" width="45" height="14" uuid="c1c2c3c4-5555-6666-7777-888899990000"/>
                <textElement textAlignment="Center"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[GRADE]]></text>
            </staticText>
            <staticText>
                <reportElement x="370" y="3" width="170" height="14" uuid="c1c2c3c4-6666-7777-8888-999900001111"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[TEACHER REMARKS]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- 4. DETAIL BAND: Dynamic Subject Looping -->
    <detail>
        <band height="20">
            <textField>
                <reportElement x="5" y="1" width="40" height="16" uuid="d1d2d3d4-1111-2222-3333-444455556666"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Monospaced" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{subjectCode}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="1" width="180" height="16" uuid="d1d2d3d4-2222-3333-4444-555566667777"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{subjectName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="235" y="1" width="80" height="16" uuid="d1d2d3d4-3333-4444-5555-666677778888"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{rawScore} + " / " + $F{maxScore}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="1" width="45" height="16" uuid="d1d2d3d4-4444-5555-6666-777788889999"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{letterGrade}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="370" y="1" width="170" height="16" uuid="d1d2d3d4-5555-6666-7777-888899990000"/>
                <textElement verticalAlignment="Middle"><font size="8" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$F{teacherRemarks}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="19" width="545" height="1" forecolor="#F1F5F9" uuid="d1d2d3d4-6666-7777-8888-999900001111"/>
            </line>
        </band>
    </detail>

    <!-- 5. SUMMARY BAND: Side-by-Side Attendance Box & GPA/Honors -->
    <summary>
        <band height="145">
            <rectangle radius="5">
                <reportElement x="0" y="10" width="260" height="60" backcolor="#F8FAFC" forecolor="#E2E8F0" uuid="e1e2e3e4-1111-2222-3333-444455556666"/>
            </rectangle>
            <staticText>
                <reportElement x="10" y="15" width="240" height="14" uuid="e1e2e3e4-2222-3333-4444-555566667777"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[OFFICIAL ATTENDANCE PROFILE]]></text>
            </staticText>
            <textField>
                <reportElement x="10" y="32" width="240" height="32" uuid="e1e2e3e4-3333-4444-5555-666677778888"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Days Present: " + $F{daysPresent} + " / " + $F{daysEnrolled} + " Days  (" + $F{attendanceRate} + ")\n" + "Absences: " + $F{daysAbsent} + " Days"]]></textFieldExpression>
            </textField>

            <rectangle radius="5">
                <reportElement x="275" y="10" width="270" height="60" backcolor="#F0FDF4" forecolor="#BBF7D0" uuid="e1e2e3e4-4444-5555-6666-777788889999"/>
            </rectangle>
            <textField>
                <reportElement x="285" y="15" width="250" height="16" forecolor="#15803D" uuid="e1e2e3e4-5555-6666-7777-888899990000"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["STANDING: " + $F{honorStatus}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="285" y="33" width="250" height="30" uuid="e1e2e3e4-6666-7777-8888-999900001111"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Evaluation: " + $F{gpaOrAverage} + "\nClass Rank: " + $F{classRank}]]></textFieldExpression>
            </textField>

            <image onErrorType="Blank">
                <reportElement x="415" y="85" width="120" height="40" uuid="e1e2e3e4-7777-8888-9999-000011112222"/>
                <imageExpression><![CDATA[$P{P_PRINCIPAL_SIGNATURE}]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="415" y="128" width="120" height="12" uuid="e1e2e3e4-8888-9999-0000-111122223333"/>
                <textElement textAlignment="Center"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Principal Signature & Seal]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
