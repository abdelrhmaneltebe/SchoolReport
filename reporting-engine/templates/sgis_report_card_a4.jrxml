<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SgisTrimesterReportCard" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="15" bottomMargin="15" uuid="c7645c1e-3872-4b32-bb21-dedfaa1f3460">
	<parameter name="P_SCHOOL_NAME" class="java.lang.String">
		<defaultValueExpression><![CDATA["SUN OF GLORY AM SCHOOL"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_REPORT_TITLE" class="java.lang.String">
