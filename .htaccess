<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to hidden/sensitive files and folders
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^composer\.(json|lock) - [F,L,NC]
    RewriteRule ^package(-lock)?\.json - [F,L,NC]
    RewriteRule ^phpunit\.xml - [F,L,NC]
    RewriteRule ^artisan - [F,L,NC]
    RewriteRule ^storage/logs/ - [F,L,NC]

    # Forward all requests into the public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
