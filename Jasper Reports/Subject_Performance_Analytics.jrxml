					<font fontName="SansSerif" size="7" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{avgTotalScore} != null ? ($F{avgTotalScore}.doubleValue() >= 85.0 ? "EXEMPLARY" : ($F{avgTotalScore}.doubleValue() >= 70.0 ? "OPTIMAL" : ($F{avgTotalScore}.doubleValue() >= 60.0 ? "BORDERLINE" : "ACTION REQ"))) : "--"]]></textFieldExpression>
			</textField>
		</band>
	</detail>

	<!-- Page Footer: Must come BEFORE Summary in JasperReports schema! -->
	<pageFooter>
		<band height="18">
			<line>
				<reportElement x="0" y="2" width="555" height="1" forecolor="#E2E8F0" uuid="f1a2b3c4-0001-8001-c001-000000000001"/>
			</line>
			<textField>
				<reportElement x="0" y="5" width="260" height="12" forecolor="#94A3B8" uuid="f1a2b3c4-0002-8001-c001-000000000002"/>
				<textElement verticalAlignment="Middle">
					<font fontName="SansSerif" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA["School Reporting Hub • Subject & Department Analytics • " + $P{P_SCHOOL_CODE}]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement x="375" y="5" width="180" height="12" forecolor="#94A3B8" uuid="f1a2b3c4-0003-8001-c001-000000000003"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="SansSerif" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>

	<!-- Summary Band: School Institutional Averages & Endorsements -->
	<summary>
		<band height="100">
			<!-- Total Summary Box -->
			<rectangle radius="4">
				<reportElement x="0" y="8" width="555" height="24" forecolor="#CBD5E1" backcolor="#F1F5F9" uuid="e1f2a3b4-0001-7001-b001-000000000001"/>
			</rectangle>
			<staticText>
				<reportElement x="10" y="12" width="220" height="15" forecolor="#0F172A" uuid="e1f2a3b4-0002-7001-b001-000000000002"/>
				<textElement verticalAlignment="Middle">
					<font fontName="SansSerif" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[INSTITUTIONAL OVERALL PERFORMANCE BENCHMARK:]]></text>
			</staticText>
			<textField>
				<reportElement x="235" y="12" width="130" height="15" forecolor="#312E81" uuid="e1f2a3b4-0003-7001-b001-000000000003"/>
				<textElement verticalAlignment="Middle">
					<font fontName="SansSerif" size="8" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Total Student Records: " + ($V{V_TOTAL_ENROLLED_ALL} != null ? $V{V_TOTAL_ENROLLED_ALL} : 0)]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.0">
				<reportElement x="375" y="12" width="170" height="15" forecolor="#059669" uuid="e1f2a3b4-0004-7001-b001-000000000004"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="SansSerif" size="8" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Campus Overall Mean: " + ($V{V_OVERALL_AVG_SCORE} != null ? $V{V_OVERALL_AVG_SCORE} + "%" : "--")]]></textFieldExpression>
			</textField>

			<!-- Signatures & Accreditation Attestation -->
			<staticText>
				<reportElement x="0" y="40" width="250" height="20" forecolor="#64748B" uuid="e1f2a3b4-0005-7001-b001-000000000005"/>
				<textElement>
					<font fontName="SansSerif" size="7"/>
				</textElement>
				<text><![CDATA[Official academic audit compiled from live student gradebook records. Certified compliant with Cognia accreditation standards.]]></text>
			</staticText>

			<line>
				<reportElement x="280" y="70" width="120" height="1" forecolor="#94A3B8" uuid="e1f2a3b4-0006-7001-b001-000000000006"/>
			</line>
			<textField>
				<reportElement x="280" y="73" width="120" height="12" forecolor="#0F172A" uuid="e1f2a3b4-0007-7001-b001-000000000007"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="8" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{P_DIRECTOR_NAME}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="280" y="85" width="120" height="11" forecolor="#64748B" uuid="e1f2a3b4-0008-7001-b001-000000000008"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="7"/>
				</textElement>
				<text><![CDATA[School Principal / Director]]></text>
			</staticText>

			<line>
				<reportElement x="425" y="70" width="120" height="1" forecolor="#94A3B8" uuid="e1f2a3b4-0009-7001-b001-000000000009"/>
			</line>
			<textField>
				<reportElement x="425" y="73" width="120" height="12" forecolor="#0F172A" uuid="e1f2a3b4-0010-7001-b001-000000000010"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="8" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{P_LEGAL_REP_NAME}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="425" y="85" width="120" height="11" forecolor="#64748B" uuid="e1f2a3b4-0011-7001-b001-000000000011"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="7"/>
				</textElement>
				<text><![CDATA[Superintendent & Legal Rep]]></text>
			</staticText>
		</band>
	</summary>
</jasperReport>
