	<!-- SQL Query for Subject & Department Level Aggregation -->
	<queryString language="SQL">
		<![CDATA[SELECT 
    COALESCE(sub.department, 'General Curriculum') AS department,
    sub.subject_code AS subjectCode,
    sub.subject_name AS subjectName,
    COALESCE(csa.credit_hours, 1.0) AS creditHours,
    COALESCE(csa.passing_mark, 60.0) AS passingMark,
    COUNT(gr.id) AS totalEnrolled,
    ROUND(AVG(COALESCE(gr.cw_score, 0)), 1) AS avgCwScore,
    ROUND(AVG(COALESCE(gr.exam_score, 0)), 1) AS avgExamScore,
    ROUND(AVG(COALESCE(gr.total_score, 0)), 1) AS avgTotalScore,
    ROUND(100.0 * SUM(CASE WHEN COALESCE(gr.total_score, 0) >= COALESCE(csa.passing_mark, 60.0) THEN 1 ELSE 0 END) / COUNT(gr.id), 1) AS passRatePercent,
    SUM(CASE WHEN gr.letter_grade IN ('A*', 'A') THEN 1 ELSE 0 END) AS countGradeA,
    SUM(CASE WHEN gr.letter_grade IN ('B+', 'B') THEN 1 ELSE 0 END) AS countGradeB,
    SUM(CASE WHEN gr.letter_grade IN ('C+', 'C') THEN 1 ELSE 0 END) AS countGradeC,
    SUM(CASE WHEN gr.letter_grade IN ('D+', 'D') THEN 1 ELSE 0 END) AS countGradeD,
    SUM(CASE WHEN gr.letter_grade = 'F' OR COALESCE(gr.total_score, 0) < COALESCE(csa.passing_mark, 60.0) THEN 1 ELSE 0 END) AS countGradeFail
FROM master_subjects sub
JOIN class_subject_assignments csa ON csa.subject_id = sub.id
JOIN school_classes c ON csa.class_id = c.id
JOIN grade_records gr ON gr.class_subject_assignment_id = csa.id
JOIN students s ON gr.student_id = s.id AND s.class_id = c.id
WHERE s.school_id = $P{P_SCHOOL_ID}
  AND gr.academic_cycle = $P{P_ACADEMIC_YEAR}
  AND gr.term_name = $P{P_TERM_NAME}
GROUP BY sub.department, sub.id, sub.subject_code, sub.subject_name, csa.credit_hours, csa.passing_mark
ORDER BY sub.department ASC, avgTotalScore DESC]]>
	</queryString>

