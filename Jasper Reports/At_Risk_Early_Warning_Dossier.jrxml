	<!-- SQL Query: Filters students with failing courses or low GPA (<2.0) -->
	<queryString language="SQL">
		<![CDATA[SELECT 
    s.id AS studentId,
    s.admission_number AS admissionNumber,
    s.full_name AS studentName,
    c.class_name AS className,
    c.homeroom_teacher AS homeroomTeacher,
    ROUND(AVG(COALESCE(gr.gpa_point, 0.0)), 2) AS currentGpa,
    ROUND(AVG(COALESCE(gr.total_score, 0.0)), 1) AS overallAvgScore,
    CAST(SUM(CASE WHEN COALESCE(gr.total_score, 0) < COALESCE(csa.passing_mark, 60.0) THEN 1 ELSE 0 END) AS SIGNED) AS failingSubjectsCount,
    GROUP_CONCAT(
        CASE WHEN COALESCE(gr.total_score, 0) < COALESCE(csa.passing_mark, 60.0) 
             THEN CONCAT(sub.subject_code, ' (', ROUND(COALESCE(gr.total_score, 0), 0), '%)') 
             ELSE NULL END 
        ORDER BY sub.subject_code ASC
        SEPARATOR ', '
    ) AS failingSubjectList,
    CAST(COALESCE(att.unexcused_count, 0) AS SIGNED) AS unexcusedAbsences
FROM students s
JOIN school_classes c ON s.class_id = c.id
JOIN grade_records gr ON gr.student_id = s.id
JOIN class_subject_assignments csa ON gr.class_subject_assignment_id = csa.id
JOIN master_subjects sub ON csa.subject_id = sub.id
LEFT JOIN (
    SELECT student_id, COUNT(*) AS unexcused_count
    FROM attendance_records
    WHERE status = 'UNEXCUSED'
    GROUP BY student_id
) att ON att.student_id = s.id
WHERE s.school_id = $P{P_SCHOOL_ID}
  AND gr.academic_cycle = $P{P_ACADEMIC_YEAR}
  AND gr.term_name = $P{P_TERM_NAME}
  AND ($P{P_CLASS_ID} IS NULL OR c.id = $P{P_CLASS_ID})
GROUP BY s.id, s.admission_number, s.full_name, c.class_name, c.homeroom_teacher, att.unexcused_count
HAVING failingSubjectsCount > 0 OR currentGpa < 2.00
ORDER BY c.class_name ASC, failingSubjectsCount DESC, currentGpa ASC]]>
	</queryString>

	<!-- Fields -->
	<field name="studentId" class="java.lang.Long"/>
	<field name="admissionNumber" class="java.lang.String"/>
	<field name="studentName" class="java.lang.String"/>
