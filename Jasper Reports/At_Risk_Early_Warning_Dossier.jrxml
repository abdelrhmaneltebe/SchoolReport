	<field name="homeroomTeacher" class="java.lang.String"/>
	<field name="currentGpa" class="java.math.BigDecimal"/>
	<field name="overallAvgScore" class="java.math.BigDecimal"/>
	<field name="failingSubjectsCount" class="java.lang.Long"/>
	<field name="failingSubjectList" class="java.lang.String"/>
	<field name="unexcusedAbsences" class="java.lang.Long"/>

